#ddev-generated
#
# Build FreeUnit (https://github.com/freeunitorg/freeunit) and its PHP
# module from source, against the same php${DDEV_PHP_VERSION}-embed package
# DDEV already installs from deb.sury.org for this project's PHP version
# (config.freeunit.yaml adds php${DDEV_PHP_VERSION}-embed and -dev to
# webimage_extra_packages, so both are already unpacked by the time this
# file's steps run -- see the "Insertion Order" table in DDEV's
# customizing-images docs).
#
# FREEUNIT_VERSION pins the git tag/branch to build; override with
# --build-arg FREEUNIT_VERSION=... via a project_files-added
# .ddev/web-build/Dockerfile if you need a different one, or bump the
# default here on update.
ARG FREEUNIT_VERSION=1.36.1

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential git pkg-config libpcre2-dev libssl-dev zlib1g-dev ca-certificates; \
    git clone --depth 1 --branch "${FREEUNIT_VERSION}" \
        https://github.com/freeunitorg/freeunit /usr/src/freeunit; \
    cd /usr/src/freeunit; \
    PHP_CONFIG="php-config${DDEV_PHP_VERSION}"; \
    command -v "$PHP_CONFIG" >/dev/null || PHP_CONFIG=php-config; \
    ./configure \
        --prefix=/usr \
        --statedir=/var/lib/freeunit \
        --control=unix:/var/run/freeunit-control.sock \
        --pid=/var/run/freeunit.pid \
        --logdir=/var/log \
        --log=/var/log/freeunit.log \
        --tmpdir=/var/tmp \
        --modulesdir=/usr/lib/freeunit/modules \
        --user=www-data \
        --group=www-data \
    ; \
    NCPU="$(nproc)"; \
    make -j"$NCPU" unitd; \
    install -pm755 build/sbin/unitd /usr/sbin/unitd-freeunit; \
    make clean; \
    ./configure \
        --prefix=/usr \
        --statedir=/var/lib/freeunit \
        --control=unix:/var/run/freeunit-control.sock \
        --pid=/var/run/freeunit.pid \
        --logdir=/var/log \
        --log=/var/log/freeunit.log \
        --tmpdir=/var/tmp \
        --modulesdir=/usr/lib/freeunit/modules \
        --user=www-data \
        --group=www-data \
    ; \
    ./configure php --config="$PHP_CONFIG" --module=php; \
    make -j"$NCPU" php-install; \
    mkdir -p /var/lib/freeunit /var/log; \
    ln -sf /dev/stderr /var/log/freeunit.log; \
    cd /; \
    rm -rf /usr/src/freeunit; \
    apt-get purge -y --auto-remove build-essential git; \
    rm -rf /var/lib/apt/lists/*; \
    unitd-freeunit --version 2>&1 | head -1

# render-config.sh and start-freeunit.sh are not copied into the image:
# they run from $DDEV_APPROOT/.ddev/freeunit/, which is part of the
# project's own bind mount, so editing them needs no rebuild, only
# `ddev restart` (or `ddev freeunit reload` for render-config.sh alone).
