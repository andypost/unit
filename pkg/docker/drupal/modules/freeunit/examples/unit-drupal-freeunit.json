{
    "listeners": {
        "*:80": {
            "pass": "routes/drupal"
        }
    },
    "routes": {
        "drupal": [
            {
                "match": {
                    "uri": [
                        "*/.ht*",
                        "/sites/*/files/*.php",
                        "/sites/*/private/*"
                    ]
                },
                "action": {
                    "return": 403
                }
            },
            {
                "match": {
                    "uri": [
                        "/vendor/*",
                        "!*/.well-known/*",
                        "*/.*",
                        "*.engine",
                        "*.inc",
                        "*.install",
                        "*.make",
                        "*.module",
                        "*.po",
                        "*.profile",
                        "*.sh",
                        "*.theme",
                        "*.twig",
                        "*.xtmpl",
                        "*.yml",
                        "*.sql",
                        "*/composer.json",
                        "*/composer.lock",
                        "*/web.config",
                        "*.bak",
                        "*.orig",
                        "*.save",
                        "*.swo",
                        "*.swp",
                        "*~"
                    ]
                },
                "action": {
                    "return": 404
                }
            },
            {
                "match": {
                    "uri": [
                        "/freeunit/cron",
                        "/freeunit/cron/*"
                    ]
                },
                "action": {
                    "return": 404
                }
            },
            {
                "match": {
                    "uri": [
                        "/core/install.php",
                        "/core/install.php/*",
                        "/core/rebuild.php",
                        "/update.php",
                        "/update.php/*",
                        "/core/modules/statistics/statistics.php"
                    ]
                },
                "action": {
                    "pass": "applications/drupal/direct"
                }
            },
            {
                "match": {
                    "uri": [
                        "!/index.php",
                        "!/index.php/*",
                        "*.php",
                        "*.php/*"
                    ]
                },
                "action": {
                    "return": 404
                }
            },
            {
                "match": {
                    "uri": [
                        "/index.php",
                        "/index.php/*"
                    ]
                },
                "action": {
                    "pass": "applications/drupal/index"
                }
            },
            {
                "action": {
                    "share": "/var/www/drupal/web$uri",
                    "fallback": {
                        "pass": "routes/drupal_page"
                    }
                }
            }
        ],
        "drupal_page": [
            {
                "match": {
                    "cookies": [
                        {
                            "SESSbfabc37432958b063360d3ad6461c9c4": "*"
                        },
                        {
                            "SSESSbfabc37432958b063360d3ad6461c9c4": "*"
                        }
                    ]
                },
                "action": {
                    "pass": "applications/drupal/index"
                }
            },
            {
                "match": {
                    "headers": {
                        "Cookie": "*SESS*"
                    }
                },
                "action": {
                    "pass": "applications/drupal/index"
                }
            },
            {
                "match": {
                    "headers": {
                        "Authorization": "*"
                    }
                },
                "action": {
                    "pass": "applications/drupal/index"
                }
            },
            {
                "match": {
                    "method": [
                        "GET",
                        "HEAD"
                    ],
                    "host": "example.org",
                    "scheme": "http",
                    "query": "",
                    "headers": {
                        "Accept-Encoding": "*gzip*"
                    }
                },
                "action": {
                    "share": "/var/lib/drupal-freeunit/page-cache/http/example.org${uri}_.html.gz",
                    "chroot": "/var/lib/drupal-freeunit/page-cache/http/example.org/",
                    "follow_symlinks": false,
                    "response_headers": {
                        "X-Drupal-Cache": "HIT-FREEUNIT",
                        "Cache-Control": "max-age=300, public",
                        "Content-Language": "en",
                        "Content-Type": "text/html; charset=utf-8",
                        "Expires": "Sun, 19 Nov 1978 05:00:00 GMT",
                        "Vary": "Cookie, Accept-Encoding",
                        "X-Content-Type-Options": "nosniff",
                        "X-Frame-Options": "SAMEORIGIN",
                        "Content-Encoding": "gzip"
                    },
                    "fallback": {
                        "pass": "applications/drupal/index"
                    }
                }
            },
            {
                "match": {
                    "method": [
                        "GET",
                        "HEAD"
                    ],
                    "host": "example.org",
                    "scheme": "http",
                    "query": ""
                },
                "action": {
                    "share": "/var/lib/drupal-freeunit/page-cache/http/example.org${uri}_.html",
                    "chroot": "/var/lib/drupal-freeunit/page-cache/http/example.org/",
                    "follow_symlinks": false,
                    "response_headers": {
                        "X-Drupal-Cache": "HIT-FREEUNIT",
                        "Cache-Control": "max-age=300, public",
                        "Content-Language": "en",
                        "Content-Type": "text/html; charset=utf-8",
                        "Expires": "Sun, 19 Nov 1978 05:00:00 GMT",
                        "Vary": "Cookie, Accept-Encoding",
                        "X-Content-Type-Options": "nosniff",
                        "X-Frame-Options": "SAMEORIGIN"
                    },
                    "fallback": {
                        "pass": "applications/drupal/index"
                    }
                }
            },
            {
                "action": {
                    "pass": "applications/drupal/index"
                }
            }
        ]
    },
    "schedules": {
        "drupal-cron": {
            "pass": "applications/drupal/index",
            "uri": "/freeunit/cron",
            "interval": 300,
            "jitter": 30,
            "timeout": 240,
            "overlap": "skip",
            "headers": {
                "Host": "example.org",
                "X-FreeUnit-Cron-Key": "REPLACE_WITH_STATE_system.cron_key"
            }
        }
    },
    "applications": {
        "drupal": {
            "type": "php",
            "user": "www-data",
            "group": "www-data",
            "processes": {
                "max": 8,
                "spare": 2,
                "idle_timeout": 60
            },
            "limits": {
                "timeout": 300
            },
            "options": {
                "file": "/usr/local/etc/php/php-freeunit-drupal.ini",
                "admin": {
                    "memory_limit": "1G",
                    "opcache.enable": "1",
                    "opcache.validate_timestamps": "1",
                    "opcache.revalidate_freq": "0",
                    "realpath_cache_size": "4096K",
                    "realpath_cache_ttl": "600",
                    "upload_max_filesize": "64M",
                    "post_max_size": "64M"
                }
            },
            "targets": {
                "direct": {
                    "root": "/var/www/drupal/web/"
                },
                "index": {
                    "root": "/var/www/drupal/web/",
                    "script": "index.php"
                }
            }
        }
    }
}
