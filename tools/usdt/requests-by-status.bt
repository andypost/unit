#!/usr/bin/env bpftrace
/*
 * Copyright (C) FreeUnit contributors.
 *
 * Request count and latency by HTTP status, plus overall request rate,
 * using request__start / request__done (src/nxt_http_request.c).
 *
 * Not run in the container this was written in (no BPF privileges /
 * no uprobe_events -- see tools/usdt/port-rtt.bt for the exact error);
 * reviewed but unverified against a live target.
 *
 * Usage:
 *   bpftrace tools/usdt/requests-by-status.bt -p $(pgrep -f 'unit: router')
 *
 * Requires a --usdt build (see docs/observability/usdt.md).
 * request__start args: (request pointer as a stable per-request id)
 * request__done  args: (request pointer, status)
 */

BEGIN
{
    printf("Tracing freeunit requests by status. Ctrl-C to stop.\n");
}

usdt:/usr/sbin/unitd:freeunit:request__start
{
    @req_start[arg0] = nsecs;
    @inflight++;
}

usdt:/usr/sbin/unitd:freeunit:request__done
{
    @by_status[arg1] = count();

    if (@req_start[arg0]) {
        @latency_by_status_ns[arg1] = hist(nsecs - @req_start[arg0]);
        delete(@req_start[arg0]);
    }

    @inflight--;
}

interval:s:10
{
    print(@by_status);
    print(@inflight);
}

END
{
    clear(@req_start);
}
