#!/usr/bin/env bash
#ddev-generated

## Description: Inspect or control the FreeUnit web server
## Usage: freeunit [status|reload|log]
## Example: "ddev freeunit status", "ddev freeunit reload", "ddev freeunit log"
## ExecRaw: false
## AutocompleteTerms: ["status", "reload", "log"]

set -euo pipefail

CONTROL_SOCK=/var/run/freeunit-control.sock
LOG_FILE=/var/log/freeunit.log
CONF_FILE=/var/run/freeunit.json
# The project's .ddev directory is bind-mounted along with the rest of the
# project at $DDEV_APPROOT, so this is where render-config.sh lives
# regardless of where DDEV places this command script itself inside the
# container.
RENDER_SCRIPT="${DDEV_APPROOT}/.ddev/freeunit/render-config.sh"

curl_control() {
    curl -fsS --unix-socket "$CONTROL_SOCK" "http://localhost$1"
}

require_socket() {
    if [ ! -S "$CONTROL_SOCK" ]; then
        echo "FreeUnit's control socket ($CONTROL_SOCK) is not there." >&2
        echo "Is the 'freeunit' daemon running? Check 'ddev logs -s web' and 'ddev freeunit log'." >&2
        exit 1
    fi
}

cmd_status() {
    require_socket
    echo "== /status =="
    curl_control /status
    echo
    echo "== /status/applications/app =="
    curl_control /status/applications/app
    echo
}

cmd_reload() {
    require_socket
    "$RENDER_SCRIPT" > "$CONF_FILE"
    echo "== re-applying ${CONF_FILE} =="
    curl_control_put_config
    echo
    echo "== restarting the app (picks up php.ini / opcache / Xdebug changes) =="
    curl_control /control/applications/app/restart
    echo
}

curl_control_put_config() {
    curl -fsS -X PUT --data-binary @"$CONF_FILE" --unix-socket "$CONTROL_SOCK" http://localhost/config
}

cmd_log() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "No log yet at $LOG_FILE." >&2
        exit 1
    fi
    tail -n "${FREEUNIT_LOG_LINES:-200}" -f "$LOG_FILE"
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    reload)
        cmd_reload
        ;;
    log)
        cmd_log
        ;;
    *)
        echo "Unknown subcommand: ${1}" >&2
        echo "Usage: ddev freeunit [status|reload|log]" >&2
        exit 1
        ;;
esac
