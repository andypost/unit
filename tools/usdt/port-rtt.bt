#!/usr/bin/env bpftrace
/*
 * Copyright (C) NGINX, Inc.
 *
 * Port send -> recv round-trip latency histogram.
 *
 * Not run in the container this was written in (no BPF privileges /
 * no uprobe_events under /sys/kernel/tracing there -- bpftrace itself
 * confirmed this with "ERROR: Unknown error -1: couldn't set
 * RLIMIT_MEMLOCK" and "open(/sys/kernel/tracing/uprobe_events): No such
 * file or directory"), so treat this as reviewed-but-unverified and
 * check it against a real target before relying on it.
 *
 * Usage:
 *   bpftrace tools/usdt/port-rtt.bt -p $(pgrep -f 'unit: router')
 *   # or against the binary directly:
 *   bpftrace -c /usr/sbin/unitd tools/usdt/port-rtt.bt
 *
 * Requires a --usdt build (see docs/observability/usdt.md).
 */

BEGIN
{
    printf("Tracing freeunit port send -> recv round trips. Ctrl-C to stop.\n");
}

usdt:/usr/sbin/unitd:freeunit:port__send
{
    /*
     * arg0 is nxt_pid at the send call site (src/nxt_port_socket.c);
     * keyed the same way the N3 plan sketch did, one in-flight send per
     * pid at a time on that pid's port-write path.
     */
    @start[arg0] = nsecs;
}

/*
 * Coarse by design: nxt_pid is constant for one process, so with a
 * single router process this tracks time-to-next-recv rather than a
 * true per-message match. Good enough for a rough distribution; add a
 * stream/cookie key to port__send/port__recv if per-message pairing is
 * needed later.
 */

usdt:/usr/sbin/unitd:freeunit:port__recv
/@start[arg0]/
{
    @port_rtt_ns = hist(nsecs - @start[arg0]);
    delete(@start[arg0]);
}

END
{
    clear(@start);
}
