#!/usr/bin/env bash
#ddev-generated
#
# Overrides DDEV's stock `ddev xdebug` command (which bounces php-fpm) for
# FreeUnit's embedded PHP SAPI: PHP is loaded once into each FreeUnit
# worker process at start, not per-request, so toggling
# /etc/php/$DDEV_PHP_VERSION/embed/conf.d/*xdebug*.ini alone does nothing
# until those workers are recycled. This enables/disables the module for
# the "embed" SAPI specifically (leaving php-cli's Xdebug, used by e.g.
# `ddev exec phpunit`, alone) and then restarts the FreeUnit app over its
# control API -- the same "restart" the ddev-frankenphp add-on gets by
# pointing DDEV's own enable_xdebug/disable_xdebug at
# `supervisorctl restart 'webextradaemons:*'`.
#
# limits.timeout for the app is also raised while Xdebug is on -- see
# render-config.sh -- because a worker paused on a breakpoint looks to
# FreeUnit's router like an application that stopped answering.

## Description: Enable or disable Xdebug for FreeUnit's embedded PHP, then restart the FreeUnit app
## Usage: xdebug [on|off|status]
## Example: "ddev xdebug on", "ddev xdebug off", "ddev xdebug status"
## ExecRaw: false
## AutocompleteTerms: ["on", "off", "enable", "disable", "toggle", "status"]

set -euo pipefail

CONTROL_SOCK=/var/run/freeunit-control.sock
CONF_FILE=/var/run/freeunit.json
RENDER_SCRIPT="${DDEV_APPROOT}/.ddev/freeunit/render-config.sh"

xdebug_loaded() {
    php -d zend_extension=xdebug -m 2>/dev/null | grep -qi '^xdebug$'
}

reload_app() {
    if [ ! -S "$CONTROL_SOCK" ]; then
        echo "Note: FreeUnit's control socket isn't up yet; the change will take effect on next start." >&2
        return 0
    fi
    "$RENDER_SCRIPT" > "$CONF_FILE"
    curl -fsS -X PUT --data-binary @"$CONF_FILE" --unix-socket "$CONTROL_SOCK" http://localhost/config >/dev/null
    curl -fsS --unix-socket "$CONTROL_SOCK" http://localhost/control/applications/app/restart >/dev/null
}

do_on() {
    phpenmod -s embed xdebug 2>/dev/null || true
    reload_app
    echo "xdebug enabled (embed SAPI); FreeUnit app restarted, limits.timeout raised."
}

do_off() {
    phpdismod -s embed xdebug 2>/dev/null || true
    reload_app
    echo "xdebug disabled (embed SAPI); FreeUnit app restarted."
}

do_status() {
    if xdebug_loaded; then
        echo "xdebug enabled"
    else
        echo "xdebug disabled"
    fi
}

case "${1:-on}" in
    on|true|enable)
        do_on
        ;;
    off|false|disable)
        do_off
        ;;
    toggle)
        if xdebug_loaded; then do_off; else do_on; fi
        ;;
    status)
        do_status
        ;;
    *)
        echo "Invalid argument: $1" >&2
        exit 1
        ;;
esac
