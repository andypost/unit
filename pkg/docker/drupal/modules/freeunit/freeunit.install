<?php

/**
 * @file
 * Install, update and uninstall functions for freeunit.
 *
 * UNVERIFIED PROTOTYPE: never installed on a Drupal site.
 */

declare(strict_types=1);

use Drupal\Core\Url;

/**
 * Implements hook_schema().
 */
function freeunit_schema(): array {
  return [
    'freeunit_static_cache' => [
      'description' => 'Cache tags of the files in the FreeUnit static page cache.',
      'fields' => [
        'file' => [
          'type' => 'varchar',
          'length' => 1024,
          'not null' => TRUE,
          'description' => 'Absolute path of the cached page (the .gz variant is implied).',
        ],
        'tag' => [
          'type' => 'varchar_ascii',
          'length' => 255,
          'not null' => TRUE,
        ],
        'expire' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Unix time after which cron deletes the file; 0 = until invalidated.',
        ],
      ],
      'indexes' => [
        'tag' => ['tag'],
        'file' => [['file', 191]],
        'expire' => ['expire'],
      ],
    ],
  ];
}

/**
 * Implements hook_requirements().
 */
function freeunit_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  // FreeUnit's SAPI registers as "cli-server" (src/nxt_php_sapi.c:299) and
  // reports itself in SERVER_SOFTWARE as "Unit/<version>"
  // (src/nxt_php_sapi.c:1549, src/nxt_main.h:15).
  $software = (string) ($_SERVER['SERVER_SOFTWARE'] ?? '');
  $on_unit = str_starts_with($software, 'Unit/');
  $requirements['freeunit_server'] = [
    'title' => t('FreeUnit'),
    'value' => $on_unit ? $software : t('Not running on FreeUnit'),
    'severity' => $on_unit ? REQUIREMENT_OK : REQUIREMENT_WARNING,
  ];

  if ($on_unit) {
    $requirements['freeunit_finish_request'] = [
      'title' => t('FreeUnit post-response work'),
      'value' => function_exists('fastcgi_finish_request')
        ? t('fastcgi_finish_request() available: kernel.terminate runs after the response is sent')
        : t('fastcgi_finish_request() missing'),
      'severity' => function_exists('fastcgi_finish_request') ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    ];
  }

  $settings = \Drupal::config('freeunit.settings');
  if ($settings->get('static_cache.enabled')) {
    $dir = (string) $settings->get('static_cache.directory');
    $ok = is_dir($dir) && is_writable($dir);
    $requirements['freeunit_static_cache'] = [
      'title' => t('FreeUnit static page cache'),
      'value' => $ok ? $dir : t('@dir is missing or not writable by the PHP workers', ['@dir' => $dir]),
      'severity' => $ok ? REQUIREMENT_OK : REQUIREMENT_ERROR,
    ];
  }

  if (\Drupal::moduleHandler()->moduleExists('automated_cron')) {
    $requirements['freeunit_cron'] = [
      'title' => t('FreeUnit cron'),
      'value' => t('automated_cron is enabled; with a FreeUnit schedule (drush freeunit:schedule --apply) it can be uninstalled.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }

  // FreeUnit's /status (processes, detached workers) is read by Drush
  // (drush freeunit:status), not here: the control socket is root-only and
  // must stay so (docs/drupal/freeunit-module.md, "Required FreeUnit
  // changes", F3).
  return $requirements;
}
